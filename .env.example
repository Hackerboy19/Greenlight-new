# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://greenlight.fsia.in"

# PORT: Server listening port (default 3000)
PORT=3000

# MySQL Database Configuration
DB_HOST="localhost"
DB_PORT=3306
DB_USER="greenlight_user"
DB_PASSWORD="your_secure_db_password"
DB_NAME="greenlight_db"
DB_CONNECTION_LIMIT=15

# Security & Auth
# JWT_SECRET is required when NODE_ENV=production; sign-in is refused without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
# How long an Admin CMS sign-in lasts (defaults to 12h when unset).
JWT_EXPIRES_IN="12h"

# Admin CMS accounts come from the MySQL users table. After `npm run db:migrate`,
# add people with: npm run db:create-user -- --email you@example.com --name "Name" --role admin
# (roles: admin, editor, author). For a deployment without MySQL, set one
# bootstrap admin here instead. Create the hash with:
#   npx tsx backend/scripts/hash-password.ts
ADMIN_EMAIL=""
ADMIN_NAME="Site Admin"
ADMIN_PASSWORD_HASH=""
CORS_ORIGIN="https://greenlight.fsia.in,http://localhost:3000"

# Google Search Console Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL="greenlight-gsc@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"
GSC_SITE_URL="sc-domain:greenlight.fsia.in"
